  "rewrites": [
    {
      "source": "/r/:token",
      "destination": "/api/me?r=:token"
    },
    {
      "source": "/u/:handle",
      "destination": "/u/index.html"
    },
    {
      "source": "/co/:slug",
      "destination": "/business/company/index.html"
    },
    {
      "source": "/api/remind",
      "destination": "/api/me?cron=remind"
    },
    {
      "source": "/c/:id",
      "destination": "/api/listings?page=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/listings?sitemap=1"
    }
  ],
  "functions": {
    "api/listings.js": {
      "includeFiles": "{radar/radar.json,data/us-places.json,data/us-zips.json}"
    },
    "api/sync.js": {
